# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts each company's AI key. Changing it makes stored keys unreadable.
KEY_ENCRYPTION_SECRET=

# Only used by scripts/seed.ts for the demo logins.
SEED_PASSWORD=

# Optional: fixed origin for invitation links (defaults to the request host)
APP_URL=
